# Copy this file to .env and fill in your API key
GEMINI_API_KEY=your_gemini_api_key_here
# Optional if you ever switch to ElevenLabs:
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# === YouTube Data API v3 Uploader (OAuth 2.0) ===
# Reuse from Google Cloud Console (same as Clipper AI if desired)
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
