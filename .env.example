# Copy this file to .env and fill in your API key
# Gemini API butuh billing aktif (free tier 403 untuk sebagian project)
GEMINI_API_KEY=your_gemini_api_key_here
# Groq dipakai sebagai fallback provider teks (gratis)
GROQ_API_KEY=your_groq_api_key_here

# === AI Text Provider ===
# Urutan provider untuk generate topik/script/polish. Default: antigravity,groq,gemini
AI_PROVIDER_ORDER=antigravity,groq,gemini
# Antigravity CLI headless: pakai kuota langganan Google, TANPA API key.
# AGY_BIN=C:\Users\User\AppData\Local\agy\bin\agy.exe
# AGY_MODEL=gemini-4-neon
# AGY_TIMEOUT_MS=240000
# Optional if you ever switch to ElevenLabs:
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# === YouTube Data API v3 Uploader (OAuth 2.0) ===
# Reuse from Google Cloud Console (same as Clipper AI if desired)
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
